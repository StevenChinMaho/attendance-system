# 正式環境設定範本。在伺服器上複製成 .env.production 後填值：
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# .env.production 已經在 .gitignore 與 .dockerignore 裡，不會進版本控制、
# 也不會被烤進映像——設定值是在容器啟動時由 compose 注入的。
#
# 改完之後要讓設定生效，用 `docker compose ... up -d`，**不要用 restart**：
# restart 只是把同一個容器停掉再開，容器建立時注入的環境變數不會重讀，
# 改動看起來沒有任何效果（見 docker/production/entrypoint.sh 的說明）。

# =====================================================================
# 應用程式
# =====================================================================
APP_NAME="校園點名系統"
APP_ENV=production

# 用這行產生，把整串（含 base64: 前綴）貼進來：
#
#     echo "base64:$(openssl rand -base64 32)"
#
# 這跟 Laravel 的 key:generate 產出的東西完全等價——後者實際做的就是
# 'base64:'.base64_encode(random_bytes(32))（cipher 是 AES-256-CBC）。
# 刻意「不」用 `docker compose ... run --rm app php artisan key:generate`：
# 那條指令會走 entrypoint，於是為了拿 32 個隨機位元組，順手把 mariadb
# 拉起來、建好 volume、跑完全部 migration，還用「APP_KEY 還是空的」那份
# 環境建了 config cache——在這個步驟（你都還沒填完這個檔案）製造出一個
# 已初始化的資料庫，是完全不必要的副作用。openssl 那條瞬間完成、沒有
# 任何副作用，而且不需要映像已經建好。
#
# 這把金鑰負責加解密所有 session cookie，換掉它等於讓全站使用者被登出；
# 請一併納入備份。
APP_KEY=

# 絕對不能是 true。APP_DEBUG=true 時任何未攔截的例外（連打錯網址的
# 404/405 都算）都會回傳完整除錯頁面，內含檔案路徑、程式碼片段與環境
# 變數，等於把原始碼結構跟部分機密直接攤開給訪客看。
APP_DEBUG=false

# 對外的正式網址，必須跟 Cloudflare Tunnel 設定的 public hostname 一致，
# 且必須是 https。這個值同時決定了 bootstrap/app.php 的 trustHosts()
# 只信任哪一個主機名——填錯會讓所有請求被擋成 400。
APP_URL=https://attendance.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# =====================================================================
# 記錄
# =====================================================================
# stderr：讓記錄走 `docker compose ... logs`，容器裡不會留下一個
# 沒人輪替、會無限長大的 laravel.log。
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
# 正式環境不需要 debug 等級的雜訊；要查問題時再暫時調成 debug 並重啟。
LOG_LEVEL=warning

# =====================================================================
# 資料庫
# =====================================================================
# DB_HOST 是 compose 裡的服務名稱，不要改成 IP。
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=attendance_system
DB_USERNAME=attendance

# 應用程式用的帳號密碼。用 `openssl rand -base64 32` 產生。
DB_PASSWORD=

# MariaDB 的 root 密碼。只有 compose 建立資料庫容器時會用到，
# 應用程式不會拿它連線——刻意跟上面那組分開，讓應用程式即使被入侵
# 也拿不到資料庫的最高權限。同樣用 `openssl rand -base64 32` 產生。
DB_ROOT_PASSWORD=

# =====================================================================
# Session / 快取 / 佇列
# =====================================================================
# 三者都用 database driver，所以不需要 Redis。對應的資料表
# （sessions / cache / jobs）都已經在 migration 裡。
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 明確指定 cookie 名稱。不指定的話 config/session.php 會用
# Str::slug(APP_NAME)."_session" 推導，而 APP_NAME 是純中文時 slug 會是
# 空字串，cookie 名稱就變成 "_session"——能動，但那是巧合，而且以後
# 有人改了 APP_NAME 就會無聲換成另一個名字，讓所有人被登出。
SESSION_COOKIE=attendance_session

# 明確要求 cookie 只在 HTTPS 下傳送。bootstrap/app.php 的 trustProxies
# 已經會讓 Laravel 正確判斷出這是 HTTPS 請求，這行是不依賴那個判斷的
# 第二道保險——兩者都做，是因為這個值錯了的後果是 session cookie
# 可能以明文傳輸。
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# =====================================================================
# 資料庫備份
# =====================================================================
# 備份檔要放在主機上的哪個目錄。**必須是主機路徑，不能是 docker volume**
# ——`docker compose down -v` 會把專案宣告的 volume 全部刪掉，備份跟
# 資料庫一起消失的話這整套就沒有意義了（而那正是實際發生過的事故）。
#
# 換主機時只要改這一行。目錄不存在的話 docker 會自動建立，但擁有者會是
# root；先自己建好並 chown 給部署帳號比較好：
#     mkdir -p /opt/attendance-backups && chown deploy:deploy /opt/attendance-backups
#
# 跑在 WSL 上時要注意：/opt 是在 WSL 的虛擬磁碟裡，WSL 一旦被重設，
# 備份跟資料庫會一起消失，等於沒有真正的隔離。可以指到 /mnt/c/... 讓它
# 落在 Windows 檔案系統上，但那邊的權限語意是壞的（一律 777、chmod 無效），
# 而 dump 檔裡有全校學生姓名學號與密碼雜湊——真要那樣放請另外加密。
BACKUP_PATH=/opt/attendance-backups

# 備份檔在主機上的擁有者。用 `id -u` / `id -g` 查部署帳號的值。
# 設錯的話備份檔會是別的 uid 所有，複製到異地時會卡權限。
BACKUP_UID=1000
BACKUP_GID=1000

# 備份容器的時區。BACKUP_HOUR 是照這個時區解讀的——沒有設定的話容器
# 預設是 UTC，BACKUP_HOUR=3 會變成台灣時間 11:00 執行，正好撞上上課時間。
TZ=Asia/Taipei

# 每天幾點跑（0-23，上面 TZ 指定的時區）。凌晨完全避開早自習
# 7:30-7:45 的尖峰，而且萬一出錯，上班前還有時間處理。
BACKUP_HOUR=3

# 保留份數：每日 30 份，另外每個月的第一份長期保留 12 個月。
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# 異地鏡像：把備份複製到「另一顆實體硬碟」的目錄。
#
# 備份跟資料庫在同一顆硬碟上時，只防誤刪、不防硬體故障——這一項才是
# 真正的第二份。留空代表不啟用。
#
# 由備份容器在每次備份完成後順手做掉，沒有另外的腳本或 cron。
#
# 設定步驟只有一次：把第二顆碟用 /etc/fstab 掛好，建立目錄與標記檔，
# 擁有者設成上面的 BACKUP_UID/GID，然後填這一行、`attendance up -d`。
#
#     sudo mkdir -p /mnt/backup/attendance
#     sudo chown $(id -u):$(id -g) /mnt/backup/attendance
#     sudo chmod 700 /mnt/backup/attendance
#     echo 'attendance-system 備份鏡像目標，請勿刪除' \
#         > /mnt/backup/attendance/.attendance-mirror-target
#
# **那個標記檔是必要的，不是裝飾。** 碟沒掛上的時候，掛載點會是系統碟上
# 一個空目錄——看起來完全正常，備份會安靜地寫進系統碟、跟來源躺在一起，
# 等於根本沒有異地備份。標記檔放在「那顆碟上」，碟沒掛就讀不到，同步就
# 會被擋下來。
BACKUP_MIRROR_PATH=

# 後台的「備份過期」警告。備份最常見的失敗方式是某天默默停掉、直到真的
# 需要還原時才被發現，所以正式環境一定要打開：超過 BACKUP_WARN_AFTER_HOURS
# 小時沒有成功備份，有稽核權限的帳號就會在每一頁看到警示。
# 48 小時代表「連續漏掉兩次」——抓 24 小時的話稍微延遲就會誤報。
BACKUP_MONITOR_ENABLED=true
BACKUP_WARN_AFTER_HOURS=48

# =====================================================================
# Cloudflare Tunnel
# =====================================================================
# Cloudflare Zero Trust 儀表板建立 tunnel 後取得的 token（很長一串）。
# 這是「誰都能用它把自己接上你的網域」的憑證，等同密碼，切勿外流。
TUNNEL_TOKEN=

# =====================================================================
# 這個系統沒有寄信功能（沒有註冊、沒有密碼重設信——帳號一律由管理者
# 建立與重設，見 system_structure.md）。保留 log driver 讓框架有個
# 有效的預設值即可，不需要設定任何 SMTP。
# =====================================================================
MAIL_MAILER=log
